{
  "name": "orbflow",
  "version": "1.0.0",
  "description": "A lightweight, physics-based orb chart library for visualizing data with smooth animations and realistic orb interactions",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/orbflow.iife.js",
  "jsdelivr": "./dist/orbflow.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package && npm run size && npm run smoke",
    "check:package": "publint && attw --pack . && node scripts/verify-dist.mjs",
    "smoke": "node scripts/smoke.mjs",
    "size": "size-limit"
  },
  "keywords": [
    "orb-chart",
    "visualization",
    "canvas",
    "physics",
    "animation",
    "chart",
    "dataviz",
    "orbs",
    "react",
    "vanilla-js"
  ],
  "author": "cascadingGeek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascadingGeek/orbflow.git"
  },
  "bugs": {
    "url": "https://github.com/cascadingGeek/orbflow/issues"
  },
  "homepage": "https://github.com/cascadingGeek/orbflow#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.3.31",
    "es-check": "^9.8.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.2.0",
    "ts-jest": "^29.0.0",
    "tsdown": "0.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
