{
  "name": "orbflow",
  "version": "1.0.0",
  "description": "A lightweight, physics-based orb chart library for visualizing data with smooth animations and realistic orb interactions",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "lint": "eslint app --ext .ts,.tsx",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "orb-chart",
    "visualization",
    "canvas",
    "physics",
    "animation",
    "chart",
    "dataviz",
    "orbs",
    "react",
    "vanilla-js"
  ],
  "author": "cascadingGeek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cascadingGeek/orbflow.git"
  },
  "bugs": {
    "url": "https://github.com/cascadingGeek/orbflow/issues"
  },
  "homepage": "https://github.com/cascadingGeek/orbflow#readme",
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "tslib": "^2.6.0"
  }
}
