{
  "name": "orbflow",
  "version": "1.0.0",
  "description": "A lightweight, physics-based orb chart library for visualizing data with smooth animations and realistic orb interactions",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "orb-chart",
    "visualization",
    "canvas",
    "physics",
    "animation",
    "chart",
    "dataviz",
    "orbs",
    "react",
    "vanilla-js"
  ],
  "author": "cascadingGeek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cascadingGeek/orbflow.git"
  },
  "bugs": {
    "url": "https://github.com/cascadingGeek/orbflow/issues"
  },
  "homepage": "https://github.com/cascadingGeek/orbflow#readme",
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "simple-git-hooks": "^2.14.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
